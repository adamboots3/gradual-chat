# --- runtime ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- database --------------------------------------------------------------
# Leave empty to try local MongoDB first, then a temporary instance if unavailable.
# Temporary data is lost on server shutdown. To use an existing persistent database:
#   MONGODB_URI=mongodb://127.0.0.1:27017/gradual_chat
# Docker Compose connects the app container to its MongoDB internally; it does
# not expose MongoDB on the host. Use `docker compose up --build` for that setup.
MONGODB_URI=

# --- seed ------------------------------------------------------------------
# Seeds the demo channels/messages on first boot (idempotent).
SEED_ON_START=true

# --- misc ------------------------------------------------------------------
LOG_LEVEL=info
# Comma separated list, used for socket.io CORS when the web app is served from
# another origin (the default same-origin setup does not need it).
WEB_ORIGIN=http://localhost:5173
