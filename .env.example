# --- runtime ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- database --------------------------------------------------------------
# Leave empty to use an in-memory MongoDB (great for a quick look, data is not
# persisted). Point it at a real instance for persistence:
#   docker compose up -d mongo
#   MONGODB_URI=mongodb://127.0.0.1:27017/gradual_chat
MONGODB_URI=

# --- seed ------------------------------------------------------------------
# Seeds the demo channels/messages on first boot (idempotent).
SEED_ON_START=true

# --- misc ------------------------------------------------------------------
LOG_LEVEL=info
# Comma separated list, used for socket.io CORS when the web app is served from
# another origin (the default same-origin setup does not need it).
WEB_ORIGIN=http://localhost:5173
